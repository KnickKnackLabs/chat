#!/usr/bin/env bash
#MISE description="Open a zellij chat cockpit"
#USAGE arg "[chat]" default="" help="Initial chat channel (default: $CHAT_CHANNEL or default)"
#USAGE flag "--as <as>" default="" help="Your identity (default: $CHAT_IDENTITY)"
#USAGE flag "--session <session>" default="chat-tui" help="Zellij session name"
#USAGE flag "--fresh" default=#false help="Kill/delete an existing session before opening"
#USAGE flag "--last <last>" default="80" help="Messages to show in the live view"
#USAGE flag "--poll <seconds>" default="2" help="Live view refresh interval"
#USAGE flag "--wrap-width <columns>" default="88" help="Readable message wrap width for the live view"
#USAGE flag "--justify" default=#true help="Justify prose paragraphs in the live view"
#USAGE flag "--no-justify" default=#false help="Render prose ragged instead of justified"
#USAGE flag "--justify-style <style>" default="balanced" help="Line-breaking style for justified prose: greedy or balanced"
#USAGE flag "--header-separator" default=#true help="Show message metadata above each separator"
#USAGE flag "--no-header-separator" default=#false help="Render the separator above metadata"
#USAGE flag "--message-padding <columns>" default="2" help="Pad each rendered message block by this many columns"
#USAGE flag "--color <mode>" default="always" help="Color mode for the live view: auto, always, or never"
#USAGE flag "--dry-run" default=#false help="Prepare state and print the launch command without attaching"
#USAGE example "chat tui --as alice" header="Open the default chat cockpit"
#USAGE example "chat tui fold --as alice" header="Open a specific channel"
#USAGE example "chat tui fold --as alice --fresh" header="Recreate the zellij session with the current layout"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/chat.sh"

chat_resolve "${usage_chat:-}"
chat_require_file
chat_require_identity "${usage_as:-}"
identity="$CHAT_IDENTITY"

session="${usage_session:-chat-tui}"
fresh="${usage_fresh:-false}"
last="${usage_last:-80}"
poll="${usage_poll:-2}"
wrap_width="${usage_wrap_width:-88}"
justify="${usage_justify:-true}"
no_justify="${usage_no_justify:-false}"
justify_style="${usage_justify_style:-balanced}"
header_separator="${usage_header_separator:-true}"
no_header_separator="${usage_no_header_separator:-false}"
message_padding="${usage_message_padding:-2}"
color="${usage_color:-always}"
dry_run="${usage_dry_run:-false}"
zellij="${ZELLIJ:-zellij}"

case "$last" in
  ''|*[!0-9]*) echo "Error: --last must be a non-negative integer (got: $last)" >&2; exit 1 ;;
esac
case "$poll" in
  ''|*[!0-9]*) echo "Error: --poll must be a positive integer (got: $poll)" >&2; exit 1 ;;
  0) echo "Error: --poll must be a positive integer (got: 0)" >&2; exit 1 ;;
esac
case "$wrap_width" in
  ''|*[!0-9]*) echo "Error: --wrap-width must be a positive integer (got: $wrap_width)" >&2; exit 1 ;;
  0) echo "Error: --wrap-width must be a positive integer (got: 0)" >&2; exit 1 ;;
esac
case "$message_padding" in
  ''|*[!0-9]*) echo "Error: --message-padding must be a non-negative integer (got: $message_padding)" >&2; exit 1 ;;
esac
case "$justify_style" in
  greedy|balanced) ;;
  *) echo "Error: --justify-style must be greedy or balanced (got: $justify_style)" >&2; exit 1 ;;
esac
if [ "$message_padding" -ge "$wrap_width" ]; then
  echo "Error: --message-padding must be less than --wrap-width" >&2
  exit 1
fi
case "$color" in
  auto|always|never) ;;
  *) echo "Error: --color must be auto, always, or never (got: $color)" >&2; exit 1 ;;
esac
if [ "$no_justify" = "true" ]; then
  justify=false
fi
if [ "$no_header_separator" = "true" ]; then
  header_separator=false
fi

safe_session=$(printf '%s' "$session" | tr -c 'A-Za-z0-9_.-' '_')
state_dir="$CHAT_DATA_DIR/.tui/$safe_session"
session_root_file="$state_dir/root"
session_exists=false
sessions=""
if sessions="$("$zellij" list-sessions --short --no-formatting 2>&1)"; then
  :
else
  list_status=$?
  if [ "$list_status" -eq 1 ] && [ "$sessions" = "No active zellij sessions found." ]; then
    sessions=""
  else
    printf 'Error: unable to inspect zellij sessions before opening %s.\n' "$session" >&2
    [ -z "$sessions" ] || printf '%s\n' "$sessions" >&2
    exit "$list_status"
  fi
fi
while IFS= read -r existing_session; do
  if [ "$existing_session" = "$session" ]; then
    session_exists=true
    break
  fi
done <<< "$sessions"

stale_session=false
if [ "$session_exists" = "true" ]; then
  recorded_root=""
  if [ -f "$session_root_file" ]; then
    recorded_root="$(cat "$session_root_file")"
  fi
  if [ "$recorded_root" != "$MISE_CONFIG_ROOT" ]; then
    stale_session=true
  fi
fi

mkdir -p "$state_dir"
printf '%s\n' "$CHAT_NAME" > "$state_dir/channel"
printf '%s\n' "$identity" > "$state_dir/identity"

export CHAT_TUI_ROOT="$MISE_CONFIG_ROOT"
export CHAT_TUI_STATE_DIR="$state_dir"
export CHAT_CHANNEL="$CHAT_NAME"
export CHAT_IDENTITY="$identity"
export CHAT_TUI_LAST="$last"
export CHAT_TUI_POLL="$poll"
export CHAT_TUI_WRAP_WIDTH="$wrap_width"
export CHAT_TUI_JUSTIFY="$justify"
export CHAT_TUI_JUSTIFY_STYLE="$justify_style"
export CHAT_TUI_HEADER_SEPARATOR="$header_separator"
export CHAT_TUI_MESSAGE_PADDING="$message_padding"
export CHAT_TUI_COLOR="$color"

layout="$MISE_CONFIG_ROOT/lib/tui/layout.kdl"

if [ "$dry_run" = "true" ]; then
  printf 'prepared chat tui session %s (chat:%s as:%s)\n' "$session" "$CHAT_NAME" "$identity"
  printf 'state_dir=%s\n' "$state_dir"
  printf 'layout=%s\n' "$layout"
  printf 'pane_tasks=tui:rooms,tui:view,tui:compose\n'
  printf 'session_exists=%s\n' "$session_exists"
  printf 'session_stale=%s\n' "$stale_session"
  printf 'command=zellij attach --create --forget --force-run-commands %s options --default-layout %s\n' "$session" "$layout"
  exit 0
fi

if [ "$stale_session" = "true" ]; then
  printf 'recreating stale zellij session %s from an unknown or different chat install\n' "$session"
  fresh=true
fi

if [ "$fresh" = "true" ]; then
  if ! "$zellij" kill-session "$session" >/dev/null 2>&1; then
    : # session may not exist yet
  fi
  if ! "$zellij" delete-session "$session" >/dev/null 2>&1; then
    : # saved session may not exist yet
  fi
fi

printf '%s\n' "$MISE_CONFIG_ROOT" > "$session_root_file"
printf 'opening zellij session %s (chat:%s as:%s)\n' "$session" "$CHAT_NAME" "$identity"
exec "$zellij" attach --create --forget --force-run-commands "$session" options --default-layout "$layout"
