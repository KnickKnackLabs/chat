#!/usr/bin/env -S uv run --script
#MISE description="Migrate chat files from the legacy '### sender — ts' format to frontmatter-per-message"
#USAGE arg "[chat]" help="Only migrate this channel (default: all channels)" default=""
#USAGE flag "--dry-run" help="Show what would change without writing"
#USAGE example "chat migrate" header="Migrate every channel in the data dir"
#USAGE example "chat migrate ops" header="Migrate only the ops channel"
#USAGE example "chat migrate --dry-run" header="Preview the migration"
# /// script
# requires-python = ">=3.10"
# ///
"""
One-shot migration from the legacy flat format

    ### alice — 2026-03-25 12:05
    body...

to the frontmatter-per-message format written by the current parser.

Legacy cursors (and cursor:undo `.prev` files) stored a **line number**.
We convert each to the **message index** it pointed past, preserving every
agent's read position. Files already in the new format are skipped, so the
task is safe to re-run.
"""

import bisect
import os
import re
import sys
from datetime import datetime
from pathlib import Path

# Reuse the new-format writer from the shared parser.
lib_dir = Path(os.environ.get("MISE_CONFIG_ROOT",
              Path(__file__).resolve().parent.parent.parent)) / "lib"
sys.path.insert(0, str(lib_dir))
from parse import Message, write_chat  # noqa: E402

CHAT_DATA_DIR = Path(os.environ.get("CHAT_DATA_DIR", Path.home() / ".local/share/chat"))
TIMESTAMP_FMT = "%Y-%m-%d %H:%M"

LEGACY_HEADER_RE = re.compile(r"^### (.+?) — (\d{4}-\d{2}-\d{2} \d{2}:\d{2})(.*)$")
SOURCE_TAG = "⟵"  # ⟵ — legacy origin-channel marker


def is_legacy(text: str) -> bool:
    """A file is legacy if it has '### ' headers and no frontmatter blocks."""
    has_legacy = any(LEGACY_HEADER_RE.match(line) for line in text.split("\n"))
    return has_legacy


def parse_legacy(text: str):
    """Return (header, [(sender, ts, body, start_line, source), ...])."""
    lines = text.split("\n")
    header_end = None
    messages = []

    sender = ts = source = None
    body_lines: list[str] = []
    start_line = 0

    def flush():
        if sender is not None:
            body = "\n".join(body_lines).strip("\n")
            messages.append((sender, ts, body, start_line, source))

    for i, line in enumerate(lines, start=1):
        m = LEGACY_HEADER_RE.match(line)
        if m:
            if header_end is None:
                header_end = i - 1
            flush()
            sender = m.group(1)
            ts = datetime.strptime(m.group(2), TIMESTAMP_FMT)
            suffix = m.group(3).strip()
            source = suffix[1:].strip() if suffix.startswith(SOURCE_TAG) else None
            body_lines = []
            start_line = i
        elif sender is not None:
            body_lines.append(line)
    flush()

    if header_end is None:
        header_end = len(lines)
    header = "\n".join(lines[:header_end])
    return header, messages


def convert_cursor(value: int, start_lines: list[int]) -> int:
    """Map a legacy line-number cursor to a message index."""
    # Number of messages whose header line is at or before the cursor line.
    return bisect.bisect_right(start_lines, value)


def migrate_file(path: Path, dry_run: bool) -> bool:
    text = path.read_text()
    if not is_legacy(text):
        return False

    header, legacy = parse_legacy(text)
    start_lines = [start for (_, _, _, start, _) in legacy]

    messages = [
        Message(sender=s, timestamp=t, body=b, message_index=idx, id=idx, source=src)
        for idx, (s, t, b, _, src) in enumerate(legacy, start=1)
    ]

    name = path.stem
    cursor_dir = CHAT_DATA_DIR / ".cursors" / name
    cursor_changes = []
    if cursor_dir.is_dir():
        for cf in sorted(cursor_dir.iterdir()):
            if not cf.is_file():
                continue
            try:
                old = int(cf.read_text().strip() or "0")
            except ValueError:
                continue
            new = convert_cursor(old, start_lines)
            cursor_changes.append((cf, old, new))

    print(f"{name}: {len(messages)} message(s)")
    for cf, old, new in cursor_changes:
        print(f"  cursor {cf.name}: line {old} -> index {new}")

    if dry_run:
        return True

    write_chat(path, header, messages, tag_sources=True)
    for cf, _, new in cursor_changes:
        cf.write_text(str(new))
    return True


def main():
    only = os.environ.get("usage_chat", "")
    dry_run = os.environ.get("usage_dry_run", "") == "true"

    if not CHAT_DATA_DIR.is_dir():
        print(f"No chat data dir at {CHAT_DATA_DIR}; nothing to migrate.")
        return

    if only:
        files = [CHAT_DATA_DIR / f"{only}.md"]
        if not files[0].exists():
            print(f"Error: channel not found: {files[0]}", file=sys.stderr)
            sys.exit(1)
    else:
        files = sorted(CHAT_DATA_DIR.glob("*.md"))

    migrated = 0
    for path in files:
        if migrate_file(path, dry_run):
            migrated += 1

    print()
    if dry_run:
        print(f"DRY RUN — {migrated} file(s) would be migrated.")
    else:
        print(f"Migrated {migrated} file(s).")


if __name__ == "__main__":
    main()
