#!/usr/bin/env bash
#MISE description="Run Python and BATS tests"
#MISE dir="{{config_root}}"
#USAGE arg "[args]" default="" var=#true help="Test files, directories, or BATS arguments"
#USAGE example "mise run test" header="Run Python and BATS tests serially"
#USAGE example "mise run test test/messages.bats" header="Run a specific BATS test file"
#USAGE example "mise run test --filter unread" header="Filter BATS tests by name"
#USAGE example "mise run test --jobs 2" header="Run BATS tests in parallel"
set -euo pipefail

export BATS_DEFAULT_TEST_TARGET="$MISE_CONFIG_ROOT/test"
export BATS_NUMBER_OF_PARALLEL_JOBS="${BATS_NUMBER_OF_PARALLEL_JOBS:-1}"
export BATS_PARALLEL_BINARY_NAME="${BATS_PARALLEL_BINARY_NAME:-rush}"

python3 -m unittest discover -s "$MISE_CONFIG_ROOT/test/tui_render" -p 'test_*.py'
exec bats --print-output-on-failure "$@"
